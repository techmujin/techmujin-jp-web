{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techmujin-jp-web",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "main": "src/worker.js",
  "assets": {
    "directory": "."
  },
  "vars": {
    "CONTACT_TO": "info@techmujin.jp",
    "CONTACT_FROM": "テック無尽 <noreply@notify.techmujin.jp>"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
